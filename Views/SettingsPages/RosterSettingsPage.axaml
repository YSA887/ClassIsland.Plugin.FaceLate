<ci:SettingsPageBase x:Class="ClassIsland.Plugin.FaceLate.Views.SettingsPages.RosterSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:ClassIsland.Plugin.FaceLate.Controls"
                     mc:Ignorable="d"
                     d:DesignHeight="620" d:DesignWidth="1060">
    <ci:SettingsPageBase.Styles>
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
    </ci:SettingsPageBase.Styles>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Margin="0,0,0,16">

        <controls:SettingCard Grid.Row="0"
                              Title="班级名称"
                              Subtitle="花名册和考勤记录都按班级存"
                              IconGlyph="&#xE7B8;">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="TextClassName" Width="170" Watermark="如：806班"/>
                <Button Content="保存" Click="ButtonSave_OnClick"/>
                <Button Content="花名册操作 ▾" IsEnabled="{Binding Busy.IsIdle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="导入花名册文本 / CSV…" Click="MenuImport_OnClick"/>
                            <MenuItem Header="从剪贴板导入" Click="MenuImportClipboard_OnClick"/>
                            <MenuItem Header="导出花名册 CSV…" Click="MenuExport_OnClick"/>
                            <MenuItem Header="打开人脸样本目录" Click="MenuOpenFacesFolder_OnClick"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </controls:SettingCard>

        <!-- 中部：左侧名单 + 右侧编辑 -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="14">

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="TextNewName" Width="160" Watermark="新增学生姓名"/>
                        <Button Content="添加" Click="ButtonAddStudent_OnClick"/>
                    </StackPanel>
                    <TextBlock x:Name="TextRosterSummary" FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                </StackPanel>
                <ListBox x:Name="ListBoxStudents"
                         Margin="0,8,0,0"
                         ItemsSource="{Binding Students}"
                         SelectionChanged="ListBoxStudents_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2" Margin="0,2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding FaceCountText}" FontSize="11" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="1">
                <StackPanel x:Name="PanelEditor" Spacing="10">
                    <TextBlock x:Name="TextEditorHint" TextWrapping="Wrap" FontWeight="Bold"/>

                    <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="班级" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClassName, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="备注" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Note, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="状态" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <ToggleSwitch Content="参与考勤" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                            <ToggleSwitch Content="今日请假" IsChecked="{Binding OnLeave, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="groupLabel" Text="人脸录入"/>

                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                               Text="让同学正对摄像头，保持半米左右。建议每人累计 4~8 条样本，角度、光线换着来。"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="录入张数" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="NumberEnrollCount" Width="110" Minimum="1" Maximum="20" Increment="1"/>
                        <Button Content="录入方式 ▾" IsEnabled="{Binding Busy.IsIdle}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="摄像头录入（连拍若干张）" Click="MenuEnrollCamera_OnClick"/>
                                    <MenuItem Header="从图片文件录入…（可多选）" Click="MenuEnrollFile_OnClick"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="样本操作 ▾" IsEnabled="{Binding Busy.IsIdle}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="删除选中的样本" Click="MenuRemoveSample_OnClick"/>
                                    <MenuItem Header="清空该生全部人脸" Click="MenuClearFaces_OnClick"/>
                                    <MenuItem Header="从花名册删除该生" Click="MenuRemoveStudent_OnClick"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock x:Name="TextBusyHint" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
                    </StackPanel>

                    <ListBox x:Name="ListBoxSamples" Height="110" ItemsSource="{Binding Faces}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部：预览 + 日志 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <Border x:Name="BorderPreview"
                    IsVisible="False"
                    CornerRadius="8"
                    Padding="4"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Image x:Name="ImagePreview" Width="220" Height="165" Stretch="Uniform"/>
            </Border>
            <controls:ActivityLogView x:Name="LogView"/>
        </StackPanel>

        <!-- 选脸浮层：画面里有多张脸时出现，让用户点一张 -->
        <Border x:Name="BorderFacePick"
                Grid.Row="0" Grid.RowSpan="3"
                IsVisible="False"
                CornerRadius="10"
                Padding="16"
                MaxWidth="620"
                MaxHeight="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 32 0 #40000000"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           x:Name="TextFacePickTitle"
                           FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                           Margin="0,0,0,4"
                           Text="画面里有多张脸，点一下要录入的那一张"/>
                <TextBlock DockPanel.Dock="Top"
                           x:Name="TextFacePickHint"
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="跳过这张" Click="ButtonFacePickSkip_OnClick"/>
                    <Button Content="放弃本次录入" Click="ButtonFacePickCancel_OnClick"/>
                </StackPanel>

                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <Border CornerRadius="8"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="4">
                            <Image x:Name="ImageFacePickPreview" MaxHeight="280" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="也可以在下面直接点一张："
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="ItemsFacePick">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,10,10" Padding="6"
                                            Click="ButtonFaceOption_OnClick"
                                            Tag="{Binding Index}">
                                        <StackPanel Spacing="4" Width="130">
                                            <Border CornerRadius="6" ClipToBounds="True"
                                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                                                <Image Source="{Binding Thumbnail}" Width="130" Height="130"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</ci:SettingsPageBase>
